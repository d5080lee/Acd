<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>인생네컷</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background: #f5f3ef;
    font-family: Arial, "Noto Sans KR", sans-serif;
    color: #222;
    display: flex;
    justify-content: center;
    padding: 28px 16px;
  }
  .app { width: min(100%, 980px); }
  h1 { text-align:center; margin:0 0 8px; font-size:30px; }
  .sub { text-align:center; color:#777; margin:0 0 22px; }
  .layout {
    display:grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    gap:22px;
    align-items:start;
  }
  .camera-card, .result-card {
    background:#fff;
    border-radius:22px;
    padding:18px;
    box-shadow:0 8px 30px rgba(0,0,0,.08);
  }
  .camera-wrap {
    position:relative;
    overflow:hidden;
    border-radius:16px;
    background:#111;
    aspect-ratio:4/3;
  }
  video { width:100%; height:100%; object-fit:cover; display:block; transform:scaleX(-1); }
  .countdown {
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-size:100px; font-weight:900; color:#fff; text-shadow:0 3px 15px #000;
    pointer-events:none;
  }
  .status { text-align:center; min-height:24px; margin:12px 0; color:#666; }
  button {
    border:0; border-radius:13px; padding:13px 16px; font-size:15px; font-weight:700;
    cursor:pointer; background:#222; color:#fff;
  }
  button:disabled { opacity:.4; cursor:not-allowed; }
  .buttons { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; }
  .secondary { background:#e9e7e2; color:#222; }
  .frame-options { display:flex; gap:8px; margin:12px 0 18px; justify-content:center; }
  .frame-options button.active { outline:3px solid #222; }
  canvas { display:block; width:100%; height:auto; background:#fff; border-radius:8px; }
  .result-title { font-weight:800; margin-bottom:10px; }
  .hint { font-size:13px; color:#888; line-height:1.5; margin-top:12px; }
  @media (max-width:760px) {
    .layout { grid-template-columns:1fr; }
    .result-card { max-width:520px; margin:auto; }
  }
</style>
</head>
<body>
<div class="app">
  <h1>인생네컷</h1>
  <p class="sub">카메라를 허용하고 4장을 연속으로 촬영해보세요 📸</p>

  <div class="layout">
    <section class="camera-card">
      <div class="camera-wrap">
        <video id="video" autoplay playsinline></video>
        <div id="countdown" class="countdown"></div>
      </div>
      <div id="status" class="status">카메라를 준비하는 중...</div>

      <div class="frame-options">
        <button class="secondary active" data-theme="white">화이트</button>
        <button class="secondary" data-theme="black">블랙</button>
        <button class="secondary" data-theme="pink">핑크</button>
      </div>

      <div class="buttons">
        <button id="startBtn">📸 촬영 시작</button>
        <button id="retakeBtn" class="secondary" disabled>다시 찍기</button>
        <button id="downloadBtn" class="secondary" disabled>⬇ 완성본 다운로드</button>
      </div>
      <p class="hint">
        촬영 시작 → 3초 카운트다운 → 사진 1장씩, 총 4장 촬영됩니다.
        브라우저에서 카메라 권한을 허용해주세요.
      </p>
    </section>

    <section class="result-card">
      <div class="result-title">완성된 2 × 2 프레임</div>
      <canvas id="canvas" width="800" height="1100"></canvas>
      <p class="hint">사진이 모두 찍히면 이 영역에 인생네컷이 완성됩니다.</p>
    </section>
  </div>
</div>

<script>
const video = document.getElementById('video');
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const countdownEl = document.getElementById('countdown');
const statusEl = document.getElementById('status');
const startBtn = document.getElementById('startBtn');
const retakeBtn = document.getElementById('retakeBtn');
const downloadBtn = document.getElementById('downloadBtn');
const themeButtons = document.querySelectorAll('[data-theme]');

let stream = null;
let photos = [];
let theme = 'white';
let busy = false;

const themes = {
  white: { bg:'#ffffff', text:'#222222' },
  black: { bg:'#111111', text:'#ffffff' },
  pink:  { bg:'#ffdce8', text:'#6b263f' }
};

async function startCamera() {
  try {
    stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: {ideal:1280}, height:{ideal:960} },
      audio: false
    });
    video.srcObject = stream;
    statusEl.textContent = '카메라 준비 완료!';
    startBtn.disabled = false;
  } catch (e) {
    statusEl.textContent = '카메라 권한이 필요합니다. 브라우저에서 카메라를 허용해주세요.';
    startBtn.disabled = true;
    console.error(e);
  }
}

function wait(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function countdown(seconds) {
  for (let n = seconds; n > 0; n--) {
    countdownEl.textContent = n;
    await wait(1000);
  }
  countdownEl.textContent = '📸';
  await wait(250);
  countdownEl.textContent = '';
}

function capturePhoto() {
  const w = video.videoWidth || 1280;
  const h = video.videoHeight || 960;
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const x = c.getContext('2d');

  // 미리보기와 같은 좌우 반전
  x.save();
  x.translate(w, 0);
  x.scale(-1, 1);
  x.drawImage(video, 0, 0, w, h);
  x.restore();

  return c;
}

function drawCover(ctx, source, x, y, w, h) {
  const sw = source.width, sh = source.height;
  const scale = Math.max(w / sw, h / sh);
  const dw = sw * scale, dh = sh * scale;
  const dx = x + (w - dw) / 2, dy = y + (h - dh) / 2;
  ctx.drawImage(source, dx, dy, dw, dh);
}

function renderResult() {
  const t = themes[theme];
  const W = 800, H = 1100;
  canvas.width = W; canvas.height = H;
  ctx.fillStyle = t.bg;
  ctx.fillRect(0,0,W,H);

  const pad = 28, gap = 18, top = 48, bottom = 38;
  const cellW = (W - pad*2 - gap) / 2;
  const cellH = (H - top - bottom - gap*1.5) / 2;

  photos.forEach((photo, i) => {
    const col = i % 2, row = Math.floor(i / 2);
    const x = pad + col * (cellW + gap);
    const y = top + row * (cellH + gap);

    ctx.save();
    ctx.beginPath();
    ctx.roundRect(x, y, cellW, cellH, 10);
    ctx.clip();
    drawCover(ctx, photo, x, y, cellW, cellH);
    ctx.restore();
  });

  ctx.fillStyle = t.text;
  ctx.textAlign = 'center';
  ctx.font = 'bold 25px Arial, sans-serif';
  ctx.fillText('LIFE 4 CUT', W/2, 31);

  ctx.font = '18px Arial, sans-serif';
  const d = new Date();
  const date = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
  ctx.fillText(date, W/2, H-13);
}

async function shoot() {
  if (busy || !stream) return;
  busy = true;
  photos = [];
  startBtn.disabled = true;
  retakeBtn.disabled = true;
  downloadBtn.disabled = true;

  for (let i = 0; i < 4; i++) {
    statusEl.textContent = `${i+1} / 4 번째 사진을 준비하세요!`;
    await countdown(3);
    photos.push(capturePhoto());
    renderResult();
    await wait(500);
  }

  statusEl.textContent = '촬영 완료! 🎉 완성본을 다운로드할 수 있어요.';
  retakeBtn.disabled = false;
  downloadBtn.disabled = false;
  busy = false;
}

startBtn.addEventListener('click', shoot);
retakeBtn.addEventListener('click', shoot);

downloadBtn.addEventListener('click', () => {
  if (!photos.length) return;
  const a = document.createElement('a');
  a.download = '인생네컷.png';
  a.href = canvas.toDataURL('image/png');
  a.click();
});

themeButtons.forEach(btn => {
  btn.addEventListener('click', () => {
    themeButtons.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    theme = btn.dataset.theme;
    if (photos.length) renderResult();
  });
});

startBtn.disabled = true;
startCamera();
</script>
</body>
</html>
